<% if(success && success.length){ %>
    <div id="successAlert" class="alert alert-success alert-dismissible fade show mx-auto mt-3 shadow-sm" role="alert" style="max-width: 620px;">
        <i class="fa-solid fa-circle-check me-2"></i><%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if(error && error.length){ %>
    <div id="errorAlert" class="alert alert-danger alert-dismissible fade show mx-auto mt-3 shadow-sm" role="alert" style="max-width: 620px;">
        <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<script>
    setTimeout(() => {
        ["successAlert", "errorAlert"].forEach((id) => {
            const el = document.getElementById(id);
            if (el) bootstrap.Alert.getOrCreateInstance(el).close();
        });
    }, 5000);
</script>
